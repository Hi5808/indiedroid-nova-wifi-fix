[Unit]
Description=Grow root partition and btrfs filesystem to fill the eMMC
After=multi-user.target systemd-udevd.service
Wants=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nova-root-resize.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
